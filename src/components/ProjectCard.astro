---
import type { CollectionEntry } from 'astro:content';
import StatusMark from './StatusMark.astro';

interface Props {
  project: CollectionEntry<'projetos'>;
  /** Ver a nota em PostCard: o nível acompanha o contexto da página. */
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, year, status, tags } = project.data;
---

<a href={`/projetos/${project.id}/`} class="card project">
  <div class="project__top">
    <span class="card__meta">{year}</span>
    <StatusMark status={status} />
  </div>

  <Heading class="card__title">{title}</Heading>
  <p class="card__body">{description}</p>

  <ul class="tag-list project__tags" aria-label="Tecnologias">
    {tags.map((tag) => <li class="tag">{tag}</li>)}
  </ul>
</a>

<style>
  .project {
    block-size: 100%;
  }

  .project__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .project__tags {
    margin-block-start: auto;
    padding-block-start: var(--space-xs);
  }

</style>
