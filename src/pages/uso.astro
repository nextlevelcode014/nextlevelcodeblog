---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { categorias, maquinas, mudancas } from '../uso.config';

/**
 * `/uso/` fica fora do menu. O argumento era que o menu é caminho de cliente
 * e o cliente não veio saber qual gerenciador de janelas eu uso; com a saída
 * da /servicos/ não há mais cliente no menu, e o motivo que sobra é o tamanho:
 * a nav rola apertada nas telas estreitas (issue #13). A página continua sendo
 * alcançada pela /sobre/, pela busca e pelo link direto, que é o formato em
 * que ela costuma circular.
 *
 * A data mais recente do registro de mudanças vira o "atualizado em" do topo:
 * uma página de lista sem data não deixa o leitor saber se está diante de algo
 * de hoje ou de dois anos atrás.
 */
const ultima = mudancas[0];

/** ISO na mão. `new Date('2026-08-05')` é meia-noite UTC e volta um dia aqui. */
function formatar(iso: string) {
  const [ano, mes, dia] = iso.split('-');
  return `${dia}/${mes}/${ano}`;
}
---

<Base
  title="O que eu uso"
  description="O sistema, os programas e os serviços que eu rodo todo dia, com o motivo de cada escolha e o registro do que mudou."
>
  <section class="section">
    <div class="wrap">
      {/*
        A trilha aponta para a /sobre/ e não para a home: fora do menu, a
        /sobre/ é o único caminho de entrada que existe aqui dentro do site, e
        devolver a pessoa para a raiz a faria procurar de novo por uma página
        que não está no menu. Como a /uso/ mora na raiz e não em /sobre/uso/, o
        botão diz `cd ~/sobre` — `cd ..` sairia daqui para a home.
      */}
      <Breadcrumb parentHref="/sobre/" />

      <SectionHead as="h1" eyebrow="Uso" title="O que eu uso" />

      {/*
        A lead diz as duas coisas que a lista sozinha não diz: que cada item
        tem motivo, e que a página muda. Sem a segunda, quem volta daqui a um
        ano não tem como saber que voltou a uma página diferente.
      */}
      <p class="lead">
        Cada item aqui vem com o motivo de estar na máquina. Eu troco de ferramenta com
        alguma frequência, então o que mudou fica registrado no fim da página.
      </p>

      <p class="stamp">
        Atualizado em <time datetime={ultima.data}>{formatar(ultima.data)}</time>
      </p>

      {/*
        Índice das categorias. Reaproveita a pílula `.tag` em vez de inventar
        um componente: ela já é o objeto "assunto clicável" do site, e o hover
        de link já existe nela.
      */}
      <nav class="indice" aria-label="Seções desta página">
        <ul class="tag-list">
          {
            categorias.map((c) => (
              <li>
                <a class="tag" href={`#${c.slug}`}>
                  {c.titulo}
                </a>
              </li>
            ))
          }
          <li>
            <a class="tag" href="#mudancas">Mudanças</a>
          </li>
        </ul>
      </nav>

      {/* ---------------- MÁQUINAS ---------------- */}
      <section class="bloco" id="maquinas">
        <h2 class="bloco__title">As máquinas</h2>
        <div class="maquinas">
          {
            maquinas.map((m) => (
              <article class="maquina">
                <p class="maquina__papel">{m.papel}</p>
                <h3 class="maquina__nome">{m.nome}</h3>
                <p class="maquina__detalhe">{m.detalhe}</p>
              </article>
            ))
          }
        </div>
      </section>

      {/* ---------------- CATEGORIAS ---------------- */}
      {
        categorias.map((categoria) => (
          <section class="bloco reveal" id={categoria.slug}>
            <h2 class="bloco__title">{categoria.titulo}</h2>
            {categoria.nota && <p class="bloco__nota">{categoria.nota}</p>}

            <ul class="itens">
              {categoria.itens.map((item) => (
                <li class="item">
                  <p class="item__head">
                    {item.url ? (
                      <a class="item__nome" href={item.url} rel="noopener">
                        {item.nome}
                      </a>
                    ) : (
                      <span class="item__nome">{item.nome}</span>
                    )}
                    {' '}
                    <span class="item__fonte">{item.fonte}</span>
                  </p>
                  {/*
                    O link de leitura fecha a própria frase, em vez de virar um
                    bloco de "veja também" no fim da página: ali ele serviria a
                    trinta itens e a nenhum. `{' '}` explícito antes da tag,
                    senão o compilador come o espaço e cola a última palavra no
                    título do post (ver o CLAUDE.md).
                  */}
                  <p class="item__uso">
                    {item.uso}
                    {
                      item.leitura && (
                        <>
                          {' '}
                          <a class="item__leitura" href={item.leitura.href}>
                            {item.leitura.titulo}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        </>
                      )
                    }
                  </p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      {/* ---------------- MUDANÇAS ---------------- */}
      <section class="bloco" id="mudancas">
        <h2 class="bloco__title">Mudanças</h2>
        <p class="bloco__nota">
          O que entrou, o que saiu e por quê. Item novo entra no topo.
        </p>

        <ol class="log">
          {
            mudancas.map((m) => (
              <li class="log__item">
                <time class="log__data" datetime={m.data}>
                  {formatar(m.data)}
                </time>
                <p class="log__texto">{m.texto}</p>
              </li>
            ))
          }
        </ol>
      </section>

      {/*
        Aqui havia um bloco de fecho com um botão para o projeto Self-hosted.
        Saiu por decisão do autor: referência a texto meu vive na linha de `uso`
        da ferramenta que ela explica (campo `leitura` em `uso.config.ts`), onde
        ela chega no momento em que a pessoa está lendo sobre aquilo. No fim da
        página, o mesmo link apanha quem já terminou.

        A trilha abaixo não é o mesmo caso: ela não recomenda leitura nenhuma,
        devolve quem terminou de rolar uma lista longa para a página de onde
        veio.
      */}
      <Breadcrumb parentHref="/sobre/" bottom />
    </div>
  </section>
</Base>

<style>
  .stamp {
    margin-block-start: var(--space-2xs);
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .indice {
    margin-block-start: var(--space-lg);
  }

  /* Filete direcional em cima e o título logo abaixo. A anatomia vinha dos
     blocos da /servicos/, que saiu do site; o compasso ficou, porque é o
     mesmo das divisórias do resto das páginas. */
  .bloco {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid transparent;
    border-image: var(--hairline) 1;
    /* Compensa o header fixo ao chegar por âncora (/uso/#casa). */
    scroll-margin-block-start: 6rem;
  }

  .bloco__title {
    font-size: var(--fs-lg);
    letter-spacing: var(--tracking-tighter);
  }

  .bloco__nota {
    margin-block-start: var(--space-2xs);
    max-inline-size: 60ch;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* ---------------- MÁQUINAS ---------------- */
  .maquinas {
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--space-md);
  }

  @media (width >= 48rem) {
    .maquinas {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }

  .maquina__papel {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-2xs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .maquina__nome {
    margin-block-start: var(--space-3xs);
    font-size: var(--fs-md);
  }

  .maquina__detalhe {
    margin-block-start: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* ---------------- ITENS ---------------- */
  .itens {
    margin-block-start: var(--space-md);
    display: grid;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  /* Duas colunas onde couber. Cada item tem duas ou três linhas, então uma
     coluna só deixaria metade da largura vazia em tela grande. `grid` e não
     `columns`: aqui a ordem de leitura horizontal não atrapalha, e o grid
     alinha o topo dos vizinhos, que `columns` não garante. */
  @media (width >= 52rem) {
    .itens {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-xl);
    }
  }

  .item__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em;
  }

  .item__nome {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--fs-base);
  }

  a.item__nome {
    text-decoration-color: color-mix(in oklab, currentColor 25%, transparent);
  }

  /* Mono e miúda: é rótulo literal de onde o pacote vem, não nome de marca.
     Mesma razão que a antiga `.tag--tool` tinha para ser monoespaçada. */
  .item__fonte {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }

  .item__uso {
    margin-block-start: var(--space-3xs);
    max-inline-size: 52ch;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* Herda o tamanho da linha e muda só a cor: é continuação da frase, não um
     botão enfiado no meio dela. A seta não quebra sozinha porque vive dentro
     do <a>, junto da última palavra do título. */
  .item__leitura {
    color: var(--accent);
    text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
  }

  /* ---------------- MUDANÇAS ---------------- */
  .log {
    margin-block-start: var(--space-md);
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .log__item {
    display: grid;
    gap: var(--space-3xs);
  }

  /* O filete separa uma entrada da seguinte, então o último item não leva.
     Com ele, a página terminava em duas linhas horizontais quase paralelas (a
     dele e a `.rule` que abre o rodapé) com uma faixa morta no meio: o padding
     da seção ficava emoldurado em vez de ser respiro. */
  .log__item:not(:last-child) {
    padding-block-end: var(--space-sm);
    border-block-end: 1px solid transparent;
    border-image: var(--hairline) 1;
  }

  /* A data ganha coluna própria onde há largura: alinhadas, as datas viram uma
     régua de tempo à esquerda e dá para varrer o registro sem ler o texto. */
  @media (width >= 40rem) {
    .log__item {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: var(--space-md);
      align-items: baseline;
    }
  }

  .log__data {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-faint);
    white-space: nowrap;
  }

  .log__texto {
    max-inline-size: 62ch;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

</style>
