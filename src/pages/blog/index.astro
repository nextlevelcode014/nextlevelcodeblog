---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Prompt from '../../components/Prompt.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Tags ordenadas por frequência: as mais usadas aparecem primeiro.
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const topTags = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

// A mesma frase serve de lide e de `<meta description>`, a pedido do autor.
// Declarada uma vez para as duas não divergirem quando uma for editada.
const lead =
  'Tentar expressar o que você entende não é apenas uma forma de provar que você entende, mas uma forma de entender de verdade.';
---

<Base
  title="Blog"
  description={lead}
>
  <section class="section">
    <div class="wrap">
      <Prompt />

      <SectionHead
        as="h1"
        title="O que eu ando estudando"
        link={{ href: '/rss.xml', label: 'Assinar RSS' }}
      />

      {/*
        O título e o lead daqui eram "Notas de campo" e "o que eu aprendi
        quebrando e consertando as coisas", que prometiam um diário de conserto.
        Dos quatro posts, três são explicação de conceito e nenhum é conserto:
        o rótulo não correspondia ao conteúdo.

        O lead é a filosofia do blog, escrita pelo autor. Ela não lista assunto
        de propósito: os posts logo abaixo já dizem sobre o que são, e as
        etiquetas também. E não afirma nada sobre quem escreve — é uma ideia com
        a qual dá para concordar sem confiar em ninguém, e quem concorda já
        entendeu por que a página existe.

        Não troque "expressar" por "explicar" nem corte o "De fato": a frase é
        do autor e foi mantida na íntegra a pedido dele.
      */}
      <p class="lead">{lead}</p>

      {
        topTags.length > 0 && (
          <ul class="tag-list topics">
            {topTags.map(([tag, count]) => (
              <li>
                <a href={`/tags/${tag}/`} class="tag">
                  {tag} <span class="topics__count">{count}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="/tags/" class="tag topics__all">
                todas as tags →
              </a>
            </li>
          </ul>
        )
      }

      {
        posts.length > 0 ? (
          <div class="posts">
            {posts.map((post) => (
              <PostCard post={post} headingLevel="h2" />
            ))}
          </div>
        ) : (
          <p class="empty">Nenhum post publicado ainda. Em breve.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .topics {
    margin-block: var(--space-md) var(--space-lg);
  }

  /* `--text-muted` e não `--text-faint`: a pílula tem fundo próprio
     (`--bg-inset`), e sobre ele o faint dá 4,44:1 — raspando o mínimo AA de
     4,5. É o mesmo achado que o painel do site de atendimento já tinha
     registrado, com o mesmo número: faint só vale sobre o fundo da página. */
  .topics__count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .topics__all {
    background: transparent;
    border-style: dashed;
  }

  .posts {
    border-block-start: 1px solid transparent;
    border-image: var(--hairline) 1;
  }

  .empty {
    padding-block: var(--space-2xl);
    color: var(--text-muted);
    text-align: center;
  }
</style>
