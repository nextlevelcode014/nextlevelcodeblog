---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Prompt from '../../components/Prompt.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projetos = (await getCollection('projetos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Projetos"
  description="Coisas que eu construí ou mantenho: homelab, ferramentas de segurança, automações e software livre."
>
  <section class="section">
    <div class="wrap">
      <Prompt />

      <SectionHead as="h1" title="Projetos e pesquisas" />

      <p class="lead">
      </p>

      {
        projetos.length > 0 ? (
          <div class="grid">
            {projetos.map((project) => (
              <div class="reveal">
                <ProjectCard project={project} headingLevel="h2" />
              </div>
            ))}
          </div>
        ) : (
          <p class="empty">Nenhum projeto publicado ainda.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--space-lg);
  }

  /* `auto-fill` + `minmax` deixa o número de colunas ser decidido pelo espaço
     disponível: dois projetos ou vinte, a grade se acomoda sem breakpoint novo. */
  @media (width >= 48rem) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    }
  }

  .grid > .reveal {
    display: flex;
  }

  .grid > .reveal > :global(*) {
    inline-size: 100%;
  }

  .empty {
    padding-block: var(--space-2xl);
    color: var(--text-muted);
    text-align: center;
  }
</style>
