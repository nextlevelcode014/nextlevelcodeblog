---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import SectionHead from '../components/SectionHead.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { services } from '../site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projetos = (await getCollection('projetos', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<Base>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__content">
        <p class="eyebrow">Suporte · Segurança · Web</p>

        {/*
          O `{' '}` não é decorativo: o compilador do Astro descarta a quebra de
          linha que precede uma tag inline, o que colaria "no" em "próximo".
        */}
        {/*
          A quebra é escrita, não deixada para o `max-inline-size` resolver.
          Com a largura mandando, "Sua" ficava sozinho na primeira linha e o
          título caía em três degraus tortos. É o que o site de atendimento já
          fazia — o `<br />` ali não é descuido, é a quebra sendo decidida por
          quem escreveu a frase. O `min-width` da media query garante que só
          vale onde cabe: abaixo dela o título volta a quebrar sozinho.
        */}
        <h1 class="hero__title">
          Sua infraestrutura<br class="hero__break" /> no{' '}
          <span class="hero__accent">próximo nível</span><span class="hero__dot"
            aria-hidden="true">.</span>
        </h1>

        <p class="hero__lead">
          Tecnologia construída sobre quatro princípios:{' '}
          <strong>liberdade</strong>, <strong>transparência</strong>, <strong>privacidade</strong> e{' '}
          <strong>segurança</strong>.
        </p>

        <div class="hero__actions">
          <a href="/contato/" class="btn">
            Falar comigo
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/servicos/" class="btn btn--ghost">Ver serviços</a>
        </div>
      </div>

      <!-- Marca em escala grande como elemento gráfico, não como logotipo.
           aria-hidden: é decoração; o nome já está no header. -->
      <div class="hero__mark" aria-hidden="true">
        <Logo size={300} animate />
      </div>
    </div>
  </section>

  <!-- ================= SERVIÇOS ================= -->
  <section class="section" id="servicos">
    <div class="wrap">
      <SectionHead
        eyebrow="Serviços"
        title="O que eu resolvo"
        link={{ href: '/servicos/', label: 'Detalhes de cada serviço' }}
      />

      <ul class="services">
        {
          services.map((service) => (
            <li class="service reveal">
              <span class="service__num" aria-hidden="true">
                {service.number}
              </span>
              <div>
                <h3 class="service__title">{service.title}</h3>
                <p class="service__body">{service.summary}</p>
                {/*
                  Aqui havia a lista de ferramentas de cada serviço, as mesmas
                  tags que a /servicos/ mostra. Saiu por causa de onde a home
                  está na jornada: nesta dobra a pessoa ainda decide se o
                  assunto é com ela, e oito nomes que ela não reconhece
                  respondem uma pergunta que ela não fez. As tags continuam em
                  /servicos/, depois dos oito pontos de cada serviço, onde quem
                  chegou já quer prova e quem não quer passa por cima.

                  Elas seguem no `site.config.ts` porque a /servicos/ e o índice
                  da busca as consomem. Não é campo órfão.
                */}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Aqui havia uma dobra de compromissos ("O que você pode cobrar de mim"),
       com três promessas lado a lado. Saiu por três motivos, e não vale
       recriar sem resolvê-los:

       - "cobrar de mim" é ambíguo numa página que fala de preço: lê tanto como
         "exigir de mim" quanto como "me faturar";
       - três promessas empilhadas com o mesmo peso de Serviços e Projetos
         viram desconto automático de quem não conhece o autor. Promessa ocupava
         o espaço que rende para prova;
       - nenhuma delas ficava perto de onde a decisão acontece.

       Dois dos textos não sumiram, foram para onde respondem uma dúvida real:
       preço antes do trabalho em /servicos/ (onde se calcula custo) e "digo
       quando não compensa" no CTA logo abaixo (onde se hesita em escrever).

       O terceiro era a portabilidade ("nada do que eu faço fica preso comigo"),
       que ficava na /sobre/. Ele saiu do site na reescrita daquela página, por
       decisão do autor. Não é pendência e não volta.

       O dia em que existir caso real com resultado, esta dobra é o lugar
       dele. -->

  <!-- ================= PROJETOS ================= -->
  {
    projetos.length > 0 && (
      <section class="section">
        <div class="wrap">
          <SectionHead
            eyebrow="Trabalho"
            title="Projetos"
            link={{ href: '/projetos/', label: 'Todos os projetos' }}
          />
          <div class="projects-grid">
            {projetos.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= BLOG ================= -->
  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <SectionHead
            eyebrow="Escrita"
            title="Meu blog"
            link={{ href: '/blog/', label: 'Todos os posts' }}
          />
          <div class="posts">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ================= CTA ================= -->
  <section class="section">
    <div class="wrap">
      <div class="cta">
        <div>
          {/*
            Este bloco já repetiu, quase palavra por palavra, o compromisso
            "Digo quando não compensa" que fica duas dobras acima — e a mesma
            frase ainda aparecia no lead de /contato/. Três vezes a mesma
            promessa na jornada de quem clica.

            Divisão de trabalho atual: o compromisso promete, este CTA diz o
            que a pessoa recebe de volta (prazo, escopo, preço) e o /contato/
            diz como escrever. Se for mexer aqui, cheque os outros dois antes.

            O título é afirmativo de propósito: os três resumos de serviço
            acima são perguntas, e uma quarta pergunta aqui perderia o
            contraste.
          */}
          <h2 class="cta__title">Quer conversar?</h2>
          <p class="cta__body">
            Entre em contato e me descreva o que você precisa, de uma conversa sobre tecnologia a um fechamento de negócio.
          </p>
        </div>
        <a href="/contato/" class="btn">
          Começar uma conversa
          <span class="btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------------- HERO ---------------- */
  .hero {
    position: relative;
    overflow: clip;
    /* Maior que o das seções — o hero é a abertura —, mas não tanto quanto
       antes: com as seções mais juntas, 9rem aqui virava um degrau grande
       demais logo na primeira dobra. */
    padding-block: clamp(2.5rem, 1.2rem + 5.5vw, 4.5rem);
  }

  /* Brilho radial atrás do texto: dá profundidade ao navy sem introduzir
     nenhuma superfície ou borda nova. */
  .hero::before {
    content: '';
    position: absolute;
    inset-block-start: -30%;
    inset-inline-start: -10%;
    inline-size: 70%;
    aspect-ratio: 1;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--brand-blue) 16%, transparent),
      transparent 62%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (width >= 62rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  .hero__title {
    margin-block-start: var(--space-sm);
    /* `--fs-3xl` dava 72px e o título caía em três degraus tortos. O culpado
       não era o `max-inline-size` (ele calculava 1032px e nunca chegava a
       valer): quem limita é a coluna do hero, de 593px em 1280px de tela.
       "Sua infraestrutura" a 72px não cabe ali de jeito nenhum.

       54px é o teto do site de atendimento, que resolve a mesma frase em duas
       linhas na mesma largura. O `--fs-3xl` seguia sendo usado só aqui. */
    font-size: clamp(2.25rem, 1.5rem + 2.8vw, 3.375rem);
    font-weight: 700;
    letter-spacing: var(--tracking-tighter);
    max-inline-size: 22ch;
  }

  /* Só quebra onde a linha inteira cabe. Em telas estreitas o `<br>` cortaria
     cedo demais e sobraria um buraco à direita. */
  .hero__break {
    display: none;
  }

  @media (width >= 40rem) {
    .hero__break {
      display: inline;
    }
  }

  /* Azul cheio, como o destaque do site de atendimento.

     Havia aqui um degradê entre dois azuis, recortado no texto. A justificativa
     original era sobre qual degradê usar — nunca sobre precisar de um: o
     comentário defendia manter o percurso só nos azuis porque atravessar até o
     laranja passa pelo cinza. Continua verdade, e o `.` laranja no fim resolve
     o acento sem degradê nenhum.

     O que decidiu foi a marca ao lado: ela acabou de perder o mesmo degradê
     azul→azul-claro por desbotar o traço em escala. Título e símbolo dividem a
     dobra; um chapado e o outro esmaecido não se leem como a mesma marca.

     Some junto a dependência de `background-clip: text` — que exigia um
     `@supports` e um fallback só para o texto não sumir onde não há suporte. */
  .hero__accent {
    color: var(--accent);
    position: relative;
    white-space: nowrap;
  }

  /* aria-hidden no markup: leitores de tela já pausam na pontuação da frase;
     anunciar um ponto isolado só atrapalharia. */
  .hero__dot {
    color: var(--hot);
  }

  .hero__lead {
    margin-block-start: var(--space-md);
    font-size: var(--fs-md);
    color: var(--text-muted);
    max-inline-size: 48ch;
  }

  .hero__lead strong {
    color: var(--text);
    font-weight: 500;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-lg);
  }

  .hero__mark {
    display: none;
    justify-self: center;
    /* 300px de LARGURA, como no site de atendimento — lá o teto é
       `max-inline-size` e a altura sai da proporção (274px). Passar `size=300`
       ao componente dava 300 de altura e 328 de largura: a mesma marca saía
       9% maior de um lado. O `size` vira só a dimensão intrínseca do SVG. */
    inline-size: 100%;
    max-inline-size: 300px;
    /* Presente, mas ainda atrás do texto na hierarquia.

       Era 0.32, por receio de virar um segundo logotipo competindo com o do
       header. Na tela isso não acontece: o do header tem 28px e fica em cima
       à esquerda, este fica à direita e em escala. O que 0.32 fazia era apagar
       o laranja do traço — o N perdia a cor que o identifica e virava uma
       marca d'água cinzenta.

       A máscara radial que dissolvia as pontas saiu junto: ela cortava
       justamente as duas extremidades do traço que sobe, que é o gesto do
       desenho. Com a opacidade fazendo o recuo, mascarar era recuar duas
       vezes. 0.6 e sem máscara é o que o site de atendimento faz. */
    opacity: 0.6;
  }

  /* O componente entrega o SVG com altura fixa; aqui ele volta a ser fluido
     para o `max-inline-size` acima mandar. `:global` porque o SVG vem de outro
     componente e não carrega o hash de escopo desta página. */
  .hero__mark :global(svg) {
    inline-size: 100%;
    block-size: auto;
  }

  @media (width >= 62rem) {
    .hero__mark {
      display: block;
    }
  }

  /* ---------------- SERVIÇOS ---------------- */
  .services {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  .service {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: start;
    padding-block: var(--space-md);
    border-block-start: 1px solid transparent;
    border-image: var(--hairline) 1;
  }

  .service:last-child {
    border-block-end: 1px solid transparent;
    border-image: var(--hairline) 1;
  }

  @media (width >= 48rem) {
    .service {
      grid-template-columns: 5rem 1fr;
      gap: var(--space-xl);
    }
  }

  /* A numeração em laranja é o "acento pontual" que o guia de marca pede:
     alto contraste, área minúscula. */
  .service__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--fs-lg);
    line-height: 1;
    color: var(--hot);
    letter-spacing: var(--tracking-tight);
  }

  .service__title {
    font-size: var(--fs-lg);
    letter-spacing: var(--tracking-tight);
  }

  .service__body {
    margin-block-start: var(--space-2xs);
    color: var(--text-muted);
    max-inline-size: 60ch;
  }

  /* ---------------- LISTAGENS ---------------- */
  .projects-grid {
    display: grid;
    gap: var(--space-md);
  }

  @media (width >= 48rem) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .posts > :global(article:first-child) {
    border-block-start: 1px solid transparent;
    border-image: var(--hairline) 1;
  }

  /* ---------------- CTA ---------------- */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--bg-raised);
    border: 1px solid var(--line);
    /* Traço de marca no topo, azul sólido — o mesmo da `.chamada` do site de
       atendimento. Era um degradê azul→laranja, e ele competia com o laranja
       do risco de 58°: dois acentos disputando a mesma caixa. O laranja rende
       mais como ponto único (o `.` do hero, o risco da régua) do que diluído
       ao longo de uma linha. */
    border-block-start: 2px solid var(--accent);
    border-radius: var(--radius-lg);
  }

  .cta__title {
    font-size: var(--fs-lg);
    letter-spacing: var(--tracking-tight);
  }

  .cta__body {
    margin-block-start: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    max-inline-size: 52ch;
  }
</style>
